{
  "expo": {
    "name": "Football Challenges",
    "slug": "football-challenges",
    "scheme": "footballchallenges",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aliabid.footballchallenges"
    },
    "android": {
      "package": "com.aliabid.footballchallenges",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "244f7a37-9e3e-4837-86e5-3d73af695a52"
      }
    },
    "owner": "aliabid31"
  }
}
